{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "moduleResolution": "node16",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "sourceMap": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"]
    },

    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
