{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "useUnknownInCatchVariables": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "allowSyntheticDefaultImports": true
    },

    "include": ["src/**/*.ts"]
}
